# Model — OpenRouter (OpenAI-compatible API)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ATLAS_MODEL=qwen/qwen3.7-plus
ATLAS_EFFORT=medium
ATLAS_MAX_TURNS=40
# Tables read at once. Bounded at both ends: the gateway rate-limits, and every
# worker issues checks against a database Atlas does not own.
ATLAS_MAX_WORKERS=6

# Databases are normally added from the console, which stores the connection
# string for you. This is the fallback for a headless run, and the source of
# the URL named by a source's `url_env`.
#
# Use a role with SELECT and nothing else — the in-process guards are a second
# line of defence, not the first.
# ATLAS_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/dbname
# SNOWFLAKE_DATABASE_URL=snowflake://user:pass@account/DATABASE/SCHEMA?warehouse=ATLAS_WH&role=ATLAS_READER

# Password for the throwaway PostgreSQL container that `make engine-test-postgres`
# starts and destroys around the SQL tests. Nothing outside your machine ever
# accepts it, so the value is yours to pick — it lives here rather than in the
# Makefile because a tracked `user:password@host` string is a credential to
# every scanner that reads the repository. The target fails if it is unset.
# ATLAS_TEST_PG_PASSWORD=

# Query guards
ATLAS_MAX_ROWS=50
ATLAS_STATEMENT_TIMEOUT_MS=15000

# Output
ATLAS_OUTPUT_DIR=out

# Sample values in the review sheet/catalogue: strict | full
# Shivam's current review workflow expects samples to be visible. Use full for
# raw samples; strict withholds sensitive-looking, opaque, free-text, and
# high-cardinality columns and the UI will show the withholding reason instead.
ATLAS_SAMPLE_POLICY=full
