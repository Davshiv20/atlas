source_up

# Put the project venv on PATH so `pytest`, `uvicorn`, `atlas`, and `ruff` run
# directly — `uv run` still works, it is just no longer required.
export VIRTUAL_ENV="$PWD/.venv"
PATH_add "$PWD/.venv/bin"

# Configuration and secrets. `dotenv_if_exists` rather than `dotenv` so a fresh
# clone with no .env yet loads cleanly instead of erroring on cd.
dotenv_if_exists .env
dotenv_if_exists .env.local

# Warn rather than fail: a shell that refuses to open is worse than one that
# tells you what is missing.
if [ ! -d "$VIRTUAL_ENV" ]; then
  log_status "no .venv yet — run: make install"
fi
if [ ! -f .env ]; then
  log_status "no .env — copy .env.example and fill in OPENROUTER_API_KEY"
fi
