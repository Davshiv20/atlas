# Repo root. Both packages source this via `source_up`, so anything shared
# belongs here and nothing else needs to know the repo layout.
#
# Run `direnv allow` once per .envrc, and again whenever one changes — direnv
# refuses to execute a file it has not been shown, which is the whole point.

export ATLAS_ROOT="$PWD"

# Ports the Makefile and the console's dev proxy agree on.
export ENGINE_PORT="${ENGINE_PORT:-8000}"
export CONSOLE_PORT="${CONSOLE_PORT:-5173}"

# Machine-specific overrides that should never be committed.
dotenv_if_exists .envrc.local
